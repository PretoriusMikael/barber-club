# --- Supabase -------------------------------------------------------------
# Project Settings -> API. The secret key (sb_secret_...) or the legacy
# service_role key. SERVER ONLY: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=

# --- OpenAI ---------------------------------------------------------------
# Use a project-scoped key with a monthly budget set in the OpenAI dashboard.
OPENAI_API_KEY=
# Any Responses-API model id. Start small and cheap; move up only if evals say so.
OPENAI_MODEL=gpt-5.4-mini
# For reasoning models: none | minimal | low | medium | high. Leave empty for non-reasoning models.
OPENAI_REASONING_EFFORT=low

# --- n8n ------------------------------------------------------------------
# Production webhook URL of the "Lead events" workflow. Leave empty to keep
# events in the outbox (useful locally).
N8N_WEBHOOK_URL=
# Shared secret for the HMAC signature n8n verifies. `openssl rand -hex 32`
N8N_WEBHOOK_SECRET=

# --- Security -------------------------------------------------------------
# Salt for hashing visitor IPs. `openssl rand -hex 32`. Rotating it resets rate limits.
VISITOR_HASH_SALT=
# Bearer token for /api/cron/dispatch (called by an n8n Schedule trigger or Vercel Cron).
CRON_SECRET=
